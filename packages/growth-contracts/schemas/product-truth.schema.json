{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Growth ProductTruth",
  "type": "object",
  "required": ["schemaVersion", "tenantId", "brandPackVersion", "features"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "tenantId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "brandPackVersion": { "type": "string" },
    "lastReviewedAt": { "type": "string" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "platforms", "evidence", "claims", "prohibitedClaims"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string" },
          "platforms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "type", "reference", "expiresAt"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "reference": { "type": "string" },
                "expiresAt": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "status", "allowedSurfaces", "evidenceRefs", "expiresAt", "copy"],
              "properties": {
                "id": { "type": "string" },
                "status": { "type": "string" },
                "allowedSurfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "expiresAt": { "type": "string" },
                "copy": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          },
          "prohibitedClaims": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
