{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Growth QA Verdict",
  "type": "object",
  "required": ["tenantId", "artifactId", "artifactVersion", "artifactHash", "rubricVersion", "verdict", "hardFailureCodes", "softScores", "reviewerRole", "reviewedAt"],
  "properties": {
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "artifactId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "artifactVersion": { "type": "string", "pattern": "^.+$" },
    "artifactHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "rubricVersion": { "type": "string" },
    "verdict": { "enum": ["pass", "revise", "block"] },
    "hardFailureCodes": { "type": "array", "items": { "type": "string" } },
    "softScores": { "type": "object" },
    "reviewerRole": { "type": "string" },
    "reviewedAt": { "type": "string" }
  },
  "additionalProperties": false
}
