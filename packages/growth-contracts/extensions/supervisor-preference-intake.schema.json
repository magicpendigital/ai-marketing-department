{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/growth-contracts/extensions/supervisor-preference-intake.schema.json",
  "title": "Supervisor Preference Intake",
  "description": "A structured, owner-verified record produced from a form, guided interview, and labeled decision scenarios without storing a raw private transcript.",
  "type": "object",
  "required": [
    "schemaVersion",
    "intakeId",
    "tenantId",
    "version",
    "status",
    "collectionMethod",
    "principalRole",
    "operatingIntent",
    "responses",
    "decisionExamples",
    "dataBoundary",
    "ownerVerification",
    "audit"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0-incubating" },
    "intakeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$" },
    "tenantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "owner_verified", "superseded", "revoked"] },
    "collectionMethod": { "enum": ["structured_form", "guided_interview", "hybrid"] },
    "principalRole": { "type": "string", "minLength": 1 },
    "operatingIntent": {
      "type": "object",
      "required": ["objective", "successDefinition", "acceptableTradeoffs", "nonNegotiables"],
      "properties": {
        "objective": { "type": "string" },
        "successDefinition": { "type": "string" },
        "acceptableTradeoffs": { "type": "array", "items": { "type": "string" } },
        "nonNegotiables": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "responses": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["promptId", "domain", "answer", "importance", "evidenceRef"],
        "properties": {
          "promptId": { "type": "string" },
          "domain": { "enum": ["goals", "audience", "positioning", "brand", "claims", "media", "risk", "channels", "measurement", "escalation"] },
          "answer": { "type": ["string", "array", "boolean", "number"] },
          "importance": { "enum": ["preference", "strong_preference", "must", "must_not"] },
          "evidenceRef": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "decisionExamples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["exampleId", "domain", "scenarioRef", "availableChoices", "selectedChoice", "rationale", "signalsThatWouldChangeDecision"],
        "properties": {
          "exampleId": { "type": "string" },
          "domain": { "enum": ["content", "brand", "media", "claims", "channel", "budget", "risk"] },
          "scenarioRef": { "type": "string" },
          "availableChoices": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "selectedChoice": { "type": "string" },
          "rationale": { "type": "string" },
          "signalsThatWouldChangeDecision": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "dataBoundary": {
      "type": "object",
      "required": ["rawTranscriptStored", "directIdentifiersStored", "allowedDataClasses", "prohibitedDataClasses", "retentionPolicyRef"],
      "properties": {
        "rawTranscriptStored": { "const": false },
        "directIdentifiersStored": { "const": false },
        "allowedDataClasses": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "prohibitedDataClasses": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "retentionPolicyRef": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ownerVerification": {
      "type": "object",
      "required": ["status", "verifiedByRole", "verifiedAt", "changeRequestRef"],
      "properties": {
        "status": { "enum": ["pending", "verified", "rejected"] },
        "verifiedByRole": { "type": "string" },
        "verifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "changeRequestRef": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["createdAt", "createdByRole", "sourceRecordHashes"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "createdByRole": { "type": "string" },
        "sourceRecordHashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
